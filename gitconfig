[user]
	name = Mason Glidden
	email = mason@masonglidden.com
[color]
	ui = true
[core]
	editor = /usr/bin/vim
[alias]
	a = add
 	b = branch
  c = commit
  ca = commit --amend
  can = commit --amend --no-verify
  cn = commit --no-verify
  cp = cherry-pick
  co = checkout
  defb = !git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@' || echo main
  com = !git checkout "$(git defb)"
  d = diff
  ds = diff --stat
  g = grep
  l = log
  lg = log --graph --pretty=format:'%Cred%h%Creset - %C(yellow)<%an>%Creset %s %Cgreen(%cr)' --abbrev-commit --date=relative
  mff = merge --ff-only
  poh = push origin HEAD
  pom = !git pull origin "$(git defb)"
  r = reset
  ra = rebase --abort
  rc = rebase --continue
  rh = reset --hard
  rhh = reset --hard HEAD
  ri = rebase -i
  rim = !git rebase -i "$(git defb)"
  riom = !git rebase -i "origin/$(git defb)"
  s = status
  sb = submodule
  sbu = submodule update --recursive --init
  sbs = submodule sync
  sh = show
  st = stash
  stp = stash pop
[merge]
	conflictstyle = diff3
[push]
	default = simple
